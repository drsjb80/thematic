{
  "name": "thematic",
  "version": "7.0.8",
  "description": "Easily switch between themes in Firefox and Thunderbird. This extension allows you to switch between themes via keyboard combinations or every N minutes. It also allows one to specify switching to a random next theme. Autoswitching and having Thematic on the tools menu is not supported in Thunderbird.",
  "main": "jest.config.js",
  "dependencies": {
    "eslint": "^7.32.0",
    "jest": "^30.5.2",
    "web-ext": "^10.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint-config-standard": "^16.0.2",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.3.1"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:all": "jest && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drsjb80/thematic.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/drsjb80/thematic/issues"
  },
  "homepage": "https://github.com/drsjb80/thematic#readme"
}
